# Public URL of the site, used by metadata, sitemap and robots.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon — https://console.neon.tech
# Pooled connection (host contains "-pooler"), used by the app.
DATABASE_URL=
# Direct connection, used by drizzle-kit for migrations.
DATABASE_URL_UNPOOLED=

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# `stripe listen --forward-to localhost:3000/api/auth/stripe/webhook`
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_BUSINESS_MONTHLY_PRICE_ID=
STRIPE_BUSINESS_YEARLY_PRICE_ID=

# module:admin start
# Live demo only: an "Admin mode" switch on the overview lets any visitor preview
# the admin panel. Harmless if left on (sample data only), but keep it unset.
# DEMO_MODE=true
# module:admin end
