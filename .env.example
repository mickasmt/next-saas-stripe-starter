# Public URL of the site, used by metadata, sitemap and robots.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon — https://console.neon.tech
# Pooled connection (host contains "-pooler"), used by the app.
DATABASE_URL=
# Direct connection, used by drizzle-kit for migrations.
DATABASE_URL_UNPOOLED=

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Same value as above, read by the browser for the One Tap prompt. Leave it
# empty to turn the prompt off. Needs the site in "Authorized JavaScript
# origins" (http://localhost:3000 in dev), not just the redirect URI.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Stripe — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# `stripe listen --forward-to localhost:3000/api/auth/stripe/webhook`
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_BUSINESS_MONTHLY_PRICE_ID=
STRIPE_BUSINESS_YEARLY_PRICE_ID=

# module:admin start
# Live demo only: an "Admin mode" switch on the overview lets any visitor preview
# the admin panel. Harmless if left on (sample data only), but keep it unset.
# DEMO_MODE=true
# module:admin end

# module:uploads start
# Optional: Neon Object Storage for avatar and organization logo uploads.
# `neon link && neon deploy` creates the bucket declared in neon.ts and writes
# these four. Leave them empty to keep the default avatar behavior.
# https://neon.com/docs/storage/get-started
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
# Bucket name, if not the "uploads" bucket from neon.ts.
# NEON_STORAGE_BUCKET=uploads
# module:uploads end

# module:assistant start
# Optional: Neon AI Gateway for the dashboard assistant. Written by
# `neon deploy`, or copied from Console > Connect > AI Gateway. Needs prepaid
# AI Gateway credits. https://neon.com/docs/ai-gateway/get-started
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=
# Any model id from https://neon.com/models
# NEON_AI_MODEL=gpt-5-mini
# module:assistant end
