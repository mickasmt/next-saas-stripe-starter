# Neon — https://console.neon.tech
# Pooled connection (host contains "-pooler"), used by the app.
DATABASE_URL=
# Direct connection, used by drizzle-kit for migrations.
DATABASE_URL_UNPOOLED=

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# `stripe listen --forward-to localhost:3000/api/auth/stripe/webhook`
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=

# Feature flags — override a module's default (true/false).
# A module also stays off while its required services miss env vars.
# Rebuild after changing one: static pages keep the value they were built with.
# FEATURE_AUTH=true
# FEATURE_BILLING=true
# FEATURE_ADMIN=true
# FEATURE_DOCS=true # module:docs
# FEATURE_BLOG=true # module:blog
# FEATURE_CHANGELOG=true # module:changelog
