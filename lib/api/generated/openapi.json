{
  "openapi": "3.1.0",
  "info": {
    "title": "TWE Learning API",
    "version": "1.0.0",
    "description": "Authoritative contract for the learner frontend and backend/admin.",
    "license": {
      "name": "Proprietary",
      "identifier": "LicenseRef-Proprietary"
    }
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Relative API base; clients supply the backend/admin origin per environment."
    }
  ],
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "tags": [
    {
      "name": "System",
      "description": "Service health and operational readiness."
    },
    {
      "name": "Authentication",
      "description": "Learner identity, verification, password sessions, and recovery."
    },
    {
      "name": "Catalogue",
      "description": "Public tracks, courses, and available offerings."
    },
    {
      "name": "Learning",
      "description": "Authenticated progression, lessons, quizzes, and submissions."
    },
    {
      "name": "Commerce",
      "description": "Checkout and payment-provider integration."
    },
    {
      "name": "Cohorts",
      "description": "Managed-cohort schedules, attendance, and participation."
    },
    {
      "name": "Certificates",
      "description": "Public certificate verification and lifecycle information."
    }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "summary": "Register a learner with email and password",
        "tags": [
          "Authentication"
        ],
        "security": [],
        "operationId": "registerLearner",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "email",
                  "password"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 100
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 12,
                    "maxLength": 128
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created; email verification is required."
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/auth/verify-email": {
      "post": {
        "summary": "Verify a learner email address",
        "tags": [
          "Authentication"
        ],
        "security": [],
        "operationId": "verifyLearnerEmail",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "token"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "token": {
                    "type": "string",
                    "minLength": 20
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Email verified."
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/auth/password-login": {
      "post": {
        "summary": "Create a database session with verified credentials",
        "tags": [
          "Authentication"
        ],
        "security": [],
        "operationId": "passwordLogin",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated session and secure cookie."
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/auth/forgot-password": {
      "post": {
        "summary": "Request a password reset without disclosing account existence",
        "tags": [
          "Authentication"
        ],
        "security": [],
        "operationId": "requestPasswordReset",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Request accepted regardless of account existence."
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/auth/reset-password": {
      "post": {
        "summary": "Consume a reset token and revoke existing sessions",
        "tags": [
          "Authentication"
        ],
        "security": [],
        "operationId": "resetPassword",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "token",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "token": {
                    "type": "string",
                    "minLength": 20
                  },
                  "password": {
                    "type": "string",
                    "minLength": 12,
                    "maxLength": 128
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password updated and existing sessions revoked."
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Revoke the active session and clear its cookie",
        "tags": [
          "Authentication"
        ],
        "operationId": "logout",
        "responses": {
          "200": {
            "description": "Session revoked or already absent."
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Get service health",
        "tags": [
          "System"
        ],
        "security": [],
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Service is accepting requests.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/auth/session": {
      "get": {
        "summary": "Get the current learner session",
        "tags": [
          "Authentication"
        ],
        "security": [],
        "operationId": "getSession",
        "responses": {
          "200": {
            "description": "Current session or null.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "anyOf": [
                            {
                              "$ref": "#/components/schemas/Session"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/catalog/tracks": {
      "get": {
        "summary": "List published learning tracks",
        "tags": [
          "Catalogue"
        ],
        "security": [],
        "operationId": "listPublishedTracks",
        "parameters": [
          {
            "$ref": "#/components/parameters/Cursor"
          },
          {
            "$ref": "#/components/parameters/Limit"
          }
        ],
        "responses": {
          "200": {
            "description": "Published tracks.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/TrackSummary"
                          }
                        },
                        "page": {
                          "$ref": "#/components/schemas/CursorPage"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/catalog/tracks/{trackSlug}": {
      "get": {
        "summary": "Get a published learning track",
        "tags": [
          "Catalogue"
        ],
        "security": [],
        "operationId": "getPublishedTrack",
        "parameters": [
          {
            "$ref": "#/components/parameters/TrackSlug"
          }
        ],
        "responses": {
          "200": {
            "description": "Published track details and available offerings.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/TrackDetail"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/me/dashboard": {
      "get": {
        "summary": "Get the learner dashboard",
        "tags": [
          "Learning"
        ],
        "operationId": "getLearnerDashboard",
        "responses": {
          "200": {
            "description": "Learner enrollments, progress, cohort, and notifications.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/LearnerDashboard"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/lessons/{lessonId}": {
      "get": {
        "summary": "Get an accessible published lesson",
        "tags": [
          "Learning"
        ],
        "operationId": "getLesson",
        "parameters": [
          {
            "$ref": "#/components/parameters/LessonId"
          }
        ],
        "responses": {
          "200": {
            "description": "Published lesson version and learner state.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/LessonDetail"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/lessons/{lessonId}/complete": {
      "post": {
        "summary": "Mark an eligible lesson complete",
        "tags": [
          "Learning"
        ],
        "operationId": "completeLesson",
        "parameters": [
          {
            "$ref": "#/components/parameters/LessonId"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "responses": {
          "200": {
            "description": "Updated progress.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/LessonProgress"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/quizzes/{quizId}/attempts": {
      "post": {
        "summary": "Submit and grade a quiz attempt",
        "tags": [
          "Learning"
        ],
        "operationId": "submitQuizAttempt",
        "parameters": [
          {
            "$ref": "#/components/parameters/QuizId"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuizAttemptInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Graded quiz attempt.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/QuizAttemptResult"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/assignments/{assignmentId}/submissions": {
      "post": {
        "summary": "Create an assignment submission version",
        "tags": [
          "Learning"
        ],
        "operationId": "submitAssignment",
        "parameters": [
          {
            "$ref": "#/components/parameters/AssignmentId"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmissionInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created submission version.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/Submission"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/checkout-sessions": {
      "post": {
        "summary": "Create a Paystack checkout session",
        "tags": [
          "Commerce"
        ],
        "operationId": "createCheckoutSession",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckoutInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Paystack authorization URL and pending payment.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/CheckoutSession"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/payments/paystack/webhook": {
      "post": {
        "summary": "Receive a Paystack payment event",
        "tags": [
          "Commerce"
        ],
        "security": [],
        "operationId": "receivePaystackWebhook",
        "responses": {
          "200": {
            "description": "Event persisted or already received."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/cohorts/{cohortId}/check-ins": {
      "post": {
        "summary": "Check in to a cohort session",
        "tags": [
          "Cohorts"
        ],
        "operationId": "checkInToCohortSession",
        "parameters": [
          {
            "$ref": "#/components/parameters/CohortId"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "token"
                ],
                "properties": {
                  "token": {
                    "type": "string",
                    "minLength": 20
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Attendance check-in recorded.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/Attendance"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/certificates/verify/{verificationToken}": {
      "get": {
        "summary": "Verify a public certificate",
        "tags": [
          "Certificates"
        ],
        "security": [],
        "operationId": "verifyCertificate",
        "parameters": [
          {
            "name": "verificationToken",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 24
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Minimal public verification record.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/CertificateVerification"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Secure-twe.session-token"
      }
    },
    "parameters": {
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "schema": {
          "type": "string"
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 16,
          "maxLength": 200
        }
      },
      "TrackSlug": {
        "name": "trackSlug",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "LessonId": {
        "name": "lessonId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "QuizId": {
        "name": "quizId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "AssignmentId": {
        "name": "assignmentId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "CohortId": {
        "name": "cohortId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "The request is invalid or contains an expired token.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Authentication required or invalid.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Authenticated but not permitted.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "Conflict": {
        "description": "Current state prevents the operation.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "RateLimited": {
        "description": "Retry after the supplied time.",
        "headers": {
          "Retry-After": {
            "schema": {
              "type": "integer"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      }
    },
    "schemas": {
      "SuccessEnvelope": {
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "data": {},
          "meta": {
            "$ref": "#/components/schemas/ResponseMeta"
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": [
          "error",
          "meta"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "examples": [
                  "FORBIDDEN"
                ]
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "additionalProperties": true
              }
            }
          },
          "meta": {
            "$ref": "#/components/schemas/ResponseMeta"
          }
        }
      },
      "ResponseMeta": {
        "type": "object",
        "required": [
          "correlationId",
          "timestamp"
        ],
        "properties": {
          "correlationId": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
